# Build artifacts
/bin/
/dist/
/stage/
/corvus
/corvus.exe

# Go test/build scratch
*.test
*.out
*.coverprofile
coverage.out
cpu.prof
mem.prof

# Environment / local config (corvus.example.toml is the shared template)
.env
.env.local
*.local
/corvus.toml

# Project-local Corvus state (not committed)
/.corvus/

# Stray Corvus state written under a package dir by a test whose RealPath
# resolves to CWD. Never commit these.
internal/**/.corvus/

# CodeGraph per-project index (rebuilt locally; never committed)
.codegraph/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local scratch
temp/
tmp/

# git worktrees (local isolation)
.worktrees/
